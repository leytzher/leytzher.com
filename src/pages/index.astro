---
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).filter(({ data }) => data.status === 'published').sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="https://github.com/leytzher.png?size=128" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Leytzher Muro writes about reservoir engineering, computation, and the physics between them." />
		<title>Leytzher Muro | Computational Reservoir Engineering</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site-header"><a class="wordmark" href="/" aria-label="Leytzher Muro home"><img src="https://github.com/leytzher.png?size=128" alt="" /><span class="brand-name">Leytzher Muro</span><span class="brand-subtitle">computational reservoir engineering</span></a><nav aria-label="Main navigation"><a href="#articles">Articles</a><a href="#about">About</a><button class="avatar" aria-label="Open profile">LM</button></nav></header>
		<main>
			<section class="intro"><p class="eyebrow"><span></span>NOTES ON RESERVOIRS, COMPUTATION AND THE PHYSICS BETWEEN THEM</p><h1>Reservoir Engineering<br /><em>from first principles.</em></h1><p class="intro-copy">
            Essays, experiments, and working notes on reservoirs, computation, simulation, and the occasional attempt to understand things properly.
            </p><div class="intro-rule"><span>{articles.length.toString().padStart(2, '0')} published notes</span><span>Updated as the work moves</span></div></section>
			<section class="article-list" id="articles" aria-labelledby="articles-title"><div class="section-heading"><h2 id="articles-title">Latest notes</h2><span>Browse the archive</span></div>{articles.map((article, index) => <article class="article-card"><div class="card-index">{String(index + 1).padStart(2, '0')}</div><div class="card-body"><div class="card-meta"><span>{formatDate(article.data.pubDate)}</span><span>{article.data.readTime}</span></div><h3><a href={`/articles/${article.id}`}>{article.data.title}</a></h3><p>{article.data.description}</p><div class="card-footer"><div class="tags">{article.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div><a class="read-link" href={`/articles/${article.id}`}>Read note <span aria-hidden="true">↗</span></a></div></div></article>)}</section>
			<section class="about-strip" id="about"><div><p class="eyebrow"><span></span>ABOUT THE AUTHOR</p><h2>Leytzher Muro</h2></div><p>
           Reservoir engineering, scientific computing, and the occasional attempt to understand things from first principles 
            </p><a href="https://github.com/leytzher" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a></section>
		</main>
		<footer><span>Leytzher Muro / 2026</span><span>computational reservoir engineering</span></footer>
	</body>
</html>

<style>
	:root { --ink:#202321; --muted:#6f746e; --paper:#fbfaf7; --line:#dedfd9; --green:#54705a; --coral:#da6d52; } * { box-sizing:border-box; } body { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; } a { color:inherit; } .site-header { height:72px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; padding:0 max(32px, calc((100vw - 1180px) / 2)); }.wordmark { display:flex; align-items:center; gap:9px; color:var(--ink); text-decoration:none; font-size:14px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }.wordmark img { width:30px; height:30px; border-radius:50%; object-fit:cover; }.brand-name { white-space:nowrap; }.brand-subtitle { color:var(--muted); border-left:1px solid var(--line); margin-left:5px; padding-left:14px; font:400 10px 'IBM Plex Mono',monospace; letter-spacing:.06em; text-transform:lowercase; }.site-header nav { display:flex; align-items:center; gap:26px; color:var(--muted); font-size:13px; }.site-header nav a { text-decoration:none; }.avatar { width:30px; height:30px; border:0; border-radius:50%; background:var(--green); color:white; font-size:11px; cursor:pointer; }.intro, .article-list, .about-strip { max-width:940px; margin:0 auto; padding-left:32px; padding-right:32px; }.intro { padding-top:100px; padding-bottom:78px; }.eyebrow { color:var(--green); display:flex; align-items:center; gap:9px; margin:0; font:500 10px 'IBM Plex Mono',monospace; letter-spacing:.1em; text-transform:uppercase; }.eyebrow span { width:7px; height:7px; border-radius:50%; background:var(--coral); }.intro h1 { max-width:720px; margin:24px 0 20px; font:600 clamp(50px,8vw,86px)/.95 'Source Serif 4',serif; letter-spacing:-.05em; }.intro h1 em { color:var(--green); font-weight:400; }.intro-copy { max-width:500px; margin:0; color:var(--muted); font:400 21px/1.45 'Source Serif 4',serif; }.intro-rule { display:flex; justify-content:space-between; max-width:600px; border-top:1px solid var(--line); margin-top:55px; padding-top:13px; color:var(--muted); font:10px 'IBM Plex Mono',monospace; text-transform:uppercase; letter-spacing:.06em; }.article-list { padding-bottom:90px; }.section-heading { display:flex; align-items:baseline; justify-content:space-between; border-bottom:1px solid var(--ink); padding-bottom:14px; }.section-heading h2 { margin:0; font:600 28px 'Source Serif 4',serif; }.section-heading span { color:var(--muted); font:10px 'IBM Plex Mono',monospace; text-transform:uppercase; letter-spacing:.08em; }.article-card { display:grid; grid-template-columns:72px 1fr; gap:22px; padding:30px 0 34px; border-bottom:1px solid var(--line); }.card-index { color:var(--coral); padding-top:4px; font:500 12px 'IBM Plex Mono',monospace; }.card-meta { display:flex; gap:16px; color:var(--muted); font:10px 'IBM Plex Mono',monospace; text-transform:uppercase; letter-spacing:.05em; }.card-body h3 { margin:12px 0 8px; font:600 35px/1.1 'Source Serif 4',serif; letter-spacing:-.025em; }.card-body h3 a { text-decoration:none; }.card-body h3 a:hover { color:var(--green); }.card-body > p { max-width:650px; margin:0; color:var(--muted); font:18px/1.5 'Source Serif 4',serif; }.card-footer { display:flex; justify-content:space-between; align-items:center; margin-top:24px; }.tags { display:flex; gap:7px; }.tags span { background:#eeeee8; padding:7px 10px; color:var(--muted); font-size:11px; }.read-link { color:var(--green); font:500 11px 'IBM Plex Mono',monospace; text-decoration:none; }.read-link span, .about-strip a span { color:var(--coral); font-size:16px; }.about-strip { display:grid; grid-template-columns:1fr 1.3fr auto; gap:36px; align-items:end; border-top:1px solid var(--line); padding-top:42px; padding-bottom:90px; }.about-strip h2 { margin:18px 0 0; font:600 34px 'Source Serif 4',serif; }.about-strip > p { max-width:370px; margin:0; color:var(--muted); font:17px/1.5 'Source Serif 4',serif; }.about-strip a { color:var(--green); font:500 11px 'IBM Plex Mono',monospace; text-decoration:none; white-space:nowrap; } footer { max-width:940px; margin:auto; padding:25px 32px 40px; border-top:1px solid var(--line); display:flex; justify-content:space-between; color:var(--muted); font:10px 'IBM Plex Mono',monospace; letter-spacing:.08em; text-transform:uppercase; }
	@media (max-width:700px) { .site-header { padding:0 20px; }.brand-subtitle, .site-header nav a { display:none; }.intro, .article-list, .about-strip { padding-left:20px; padding-right:20px; }.intro { padding-top:65px; }.intro h1 { font-size:56px; }.intro-rule { gap:20px; }.article-card { grid-template-columns:35px 1fr; gap:10px; }.card-body h3 { font-size:29px; }.card-body > p { font-size:17px; }.card-footer { align-items:flex-start; gap:18px; flex-direction:column; }.about-strip { display:block; padding-bottom:60px; }.about-strip > p { margin:28px 0; } footer { margin:0 20px; padding-left:0; padding-right:0; gap:20px; flex-direction:column; } }
+</style>
