---
import { getCollection, render } from 'astro:content';

const [article] = await getCollection('articles');
if (!article) throw new Error('Article not found');
const { Content } = await render(article);
const { title, description, author, authorInitials, pubDate, readTime, tags } = article.data;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="https://github.com/leytzher.png?size=128" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} | Leytzher Muro</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Leytzher Muro home"><img class="profile-mark" src="https://github.com/leytzher.png?size=128" alt="" /><span class="brand-name">Leytzher Muro</span><span class="brand-subtitle">computational reservoir engineering</span></a>
			<nav class="header-nav" aria-label="Main navigation"><a href="#article">Explore</a><a href="#article">About</a><button class="search-button" aria-label="Search"><span aria-hidden="true">⌕</span></button><button class="avatar" aria-label="Open profile">LM</button></nav>
		</header>

		<main id="article">
			<article class="article-layout">
				<div class="article-main">
					<div class="eyebrow"><span class="eyebrow-dot"></span>
					NOTES ON RESERVOIRS, COMPUTATION AND THE PHYSICS BETWEEN THEM</div>
					<h1>{title}</h1>
					<p class="dek">{description}</p>
					<div class="byline-row"><div class="author-avatar">{authorInitials}</div><div class="byline"><strong>{author}</strong><span>{pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })} · {readTime}</span></div><button class="follow-button">Follow</button></div>
					<div class="story-actions" aria-label="Article actions"><button class="action-button clap-button" id="clap-button" aria-label="Clap for this article"><span class="action-icon">♡</span><span id="clap-count">128</span></button><button class="action-button" aria-label="View responses"><span class="action-icon">◌</span><span>12</span></button><span class="action-spacer"></span><button class="action-button" id="bookmark-button" aria-label="Bookmark this article"><span class="action-icon">▱</span></button><button class="action-button" aria-label="Share article"><span class="action-icon">↗</span></button></div>
					<div class="hero-figure" aria-label="Abstract topographic landscape illustration" role="img"><div class="sun"></div><div class="ridge ridge-one"></div><div class="ridge ridge-two"></div><div class="ridge ridge-three"></div><div class="ridge ridge-four"></div><span class="figure-note">FIG. 01 / A FIELD OF POSSIBILITIES</span></div>
					<p class="caption">A model does not need to be complicated to reveal something true. Sometimes it just needs room to move.</p>

					<section class="prose"><Content /></section>
					<div class="tag-list">{tags.map((tag) => <a href={`#${tag.toLowerCase()}`}>{tag}</a>)}</div><div class="end-note"><div class="author-avatar small">{authorInitials}</div><div><strong>Written by {author}</strong><p>Notes on Reservoir Engineering and Computation</p></div><button class="follow-button">Follow</button></div>
				</div>
				<aside class="reading-rail" aria-label="Article progress"><div class="rail-line"><span></span></div><span class="rail-label">01<br /><small>of 04</small></span><div class="rail-share">↗</div></aside>
			</article>
		</main>
		<footer><span>Leytzher Muro / 2026</span><span>computational reservoir engineering</span></footer>
	</body>
</html>

<style>
	:root { --ink: #202321; --muted: #6f746e; --paper: #fbfaf7; --line: #dedfd9; --green: #54705a; --coral: #da6d52; } * { box-sizing: border-box; } body { margin: 0; color: var(--ink); background: var(--paper); font-family: 'DM Sans', sans-serif; } button, a { font: inherit; } button { cursor: pointer; }
	.site-header { height: 72px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; padding: 0 max(32px, calc((100vw - 1180px) / 2)); }.wordmark { color: var(--ink); display: flex; align-items: center; gap: 9px; text-decoration: none; font-size: 14px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }.profile-mark { width: 30px; height: 30px; display: block; border-radius: 50%; object-fit: cover; }.brand-name { white-space: nowrap; }.brand-subtitle { color: var(--muted); border-left: 1px solid var(--line); margin-left: 5px; padding-left: 14px; font: 400 10px 'IBM Plex Mono', monospace; letter-spacing: .06em; text-transform: lowercase; }.mark { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: var(--coral); color: white; font: 500 12px 'IBM Plex Mono', monospace; letter-spacing: -.1em; }.header-nav { display: flex; align-items: center; gap: 26px; font-size: 13px; color: var(--muted); }.header-nav a { color: inherit; text-decoration: none; }.search-button, .avatar { border: 0; background: none; color: var(--ink); }.search-button { font-size: 25px; line-height: 1; }.avatar, .author-avatar { background: var(--green); color: #fff; border-radius: 50%; display: grid; place-items: center; }.avatar { width: 30px; height: 30px; font-size: 12px; }
	.article-layout { max-width: 1100px; padding: 70px 32px 90px; margin: auto; display: grid; grid-template-columns: minmax(0, 760px) 80px; gap: 70px; }.eyebrow { color: var(--green); font: 500 11px 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .1em; display: flex; align-items: center; gap: 9px; }.eyebrow-dot, .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--coral); display: inline-block; } h1 { max-width: 700px; margin: 22px 0 15px; font: 600 clamp(46px, 7vw, 76px)/.98 'Source Serif 4', serif; letter-spacing: -.045em; }.dek { max-width: 600px; color: var(--muted); font: 400 22px/1.4 'Source Serif 4', serif; margin: 0; }.byline-row { display: flex; align-items: center; gap: 12px; margin-top: 33px; }.author-avatar { width: 37px; height: 37px; font: 500 11px 'IBM Plex Mono', monospace; }.byline { display: grid; gap: 3px; font-size: 12px; }.byline strong { font-weight: 600; }.byline span { color: var(--muted); }.follow-button { margin-left: 13px; color: var(--green); border: 1px solid var(--green); border-radius: 20px; padding: 8px 17px; background: transparent; font-size: 12px; }.follow-button.following { background: var(--green); color: #fff; }
	.story-actions { display: flex; align-items: center; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 11px 0; margin-top: 30px; }.action-button { border: 0; background: transparent; display: flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12px; padding: 5px 10px 5px 0; margin-right: 17px; }.action-icon { color: var(--ink); font-size: 21px; }.action-spacer { flex: 1; }.clap-button.clapped .action-icon { color: var(--coral); }
	.hero-figure { height: 380px; margin-top: 42px; overflow: hidden; position: relative; background: #dbe1d6; }.sun { position: absolute; width: 130px; height: 130px; border-radius: 50%; background: #e4a16f; top: 55px; left: 18%; }.ridge { position: absolute; left: -8%; width: 116%; border-radius: 50% 50% 0 0; transform: rotate(-5deg); }.ridge-one { height: 240px; bottom: -130px; background: #6c856d; }.ridge-two { height: 205px; bottom: -115px; background: #8ea48a; transform: rotate(7deg); }.ridge-three { height: 155px; bottom: -100px; background: #b7c3a7; transform: rotate(-12deg); }.ridge-four { height: 100px; bottom: -70px; background: #e5d9b8; transform: rotate(17deg); }.figure-note { position: absolute; left: 24px; bottom: 20px; color: #fff; font: 11px 'IBM Plex Mono', monospace; letter-spacing: .08em; }.caption { color: var(--muted); font: italic 14px/1.5 'Source Serif 4', serif; margin: 12px 0 50px; }
	.prose { font: 400 20px/1.72 'Source Serif 4', serif; }.prose p { margin: 0 0 25px; }.prose h2 { font: 600 30px/1.2 'Source Serif 4', serif; margin: 50px 0 17px; letter-spacing: -.025em; }.prose pre { margin: 28px 0 0; overflow-x: auto; padding: 21px 24px 19px; background: #252b28; color: #e6ede5; border-radius: 5px 5px 0 0; font: 400 11.5px/1.72 'JetBrains Mono', 'IBM Plex Mono', monospace; font-variant-ligatures: contextual; font-feature-settings: 'calt' 1, 'liga' 1; letter-spacing: 0; tab-size: 2; }.prose pre code { font: inherit; font-variant-ligatures: inherit; }.code-cell { margin: 42px 0 50px; padding: 0 0 15px; background: #252b28; border-radius: 6px; box-shadow: 0 16px 38px rgba(34, 44, 35, .13); overflow: hidden; }.code-cell pre { margin: 0; border-radius: 0; }.code-toolbar { display: flex; align-items: center; justify-content: space-between; min-height: 52px; padding: 10px 16px 10px 19px; border-top: 1px solid #414b43; background: #222824; }.code-language { color: #a9c3ad; font: 500 10px 'JetBrains Mono', 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }.code-cell .run-button { margin: 0; }.code-cell .cell-output { margin: 14px 19px 0; min-height: 18px; color: #9ab89f; font: 400 10px/1.5 'JetBrains Mono', 'IBM Plex Mono', monospace; letter-spacing: .01em; }.code-cell .plot-output { margin-left: 19px; margin-right: 19px; }.equation { display: flex; align-items: center; justify-content: center; gap: 12px; margin: 35px 0; color: #3c5542; font: 26px 'Source Serif 4', serif; }.fraction { display: inline-grid; text-align: center; line-height: 1.05; font-size: 19px; }.fraction span:first-child { border-bottom: 1px solid currentColor; padding: 0 6px 3px; }.fraction span:last-child { padding-top: 4px; }
	.notebook { margin: 45px -40px 50px; background: #252b28; color: #e6ede5; border-radius: 5px; overflow: hidden; box-shadow: 0 14px 35px rgba(34, 44, 35, .12); font-family: 'IBM Plex Mono', monospace; }.notebook-header, .notebook-footer, .notebook-tabs { display: flex; align-items: center; }.notebook-header { justify-content: space-between; color: #bdc9bd; padding: 14px 18px; font-size: 11px; border-bottom: 1px solid #414b43; }.notebook-header > div { display: flex; align-items: center; gap: 9px; }.kernel-status { color: #849a86; }.notebook-tabs { padding: 0 18px; border-bottom: 1px solid #414b43; }.notebook-tab { color: #849a86; border: 0; background: transparent; padding: 12px 16px; font: 11px 'IBM Plex Mono', monospace; border-bottom: 2px solid transparent; }.notebook-tab.active { color: #f0b098; border-bottom-color: var(--coral); }.cell { display: grid; grid-template-columns: 55px 1fr; padding: 23px 18px 20px 0; border-bottom: 1px solid #414b43; }.cell-gutter { color: #718073; text-align: right; padding: 5px 16px 0 0; font-size: 11px; }.cell-content { min-width: 0; }.cell pre { overflow-x: auto; margin: 0; font: 12px/1.8 'IBM Plex Mono', monospace; }.kw { color: #ed9b82; }.var { color: #acd0af; }.num { color: #e6c984; }.func { color: #9fc9d0; }.string { color: #d5b98d; }.run-button { display: inline-flex; align-items: center; gap: 8px; color: #d9eadb; border: 1px solid #62866b; border-radius: 4px; padding: 8px 12px; background: #304437; margin-top: 17px; font: 500 10px 'JetBrains Mono', 'IBM Plex Mono', monospace; letter-spacing: .01em; transition: background .18s ease, border-color .18s ease, transform .18s ease; }.run-button:hover { background: #3a5541; border-color: #8fb098; transform: translateY(-1px); }.run-button:focus-visible { outline: 2px solid #f0b098; outline-offset: 3px; }.run-button:disabled { cursor: wait; opacity: .62; transform: none; }.run-button span { color: #f0b098; font-size: 9px; }.cell-output { min-height: 18px; color: #91b39a; font-size: 11px; margin-top: 13px; }.plot-output { display: none; margin-top: 14px; min-height: 132px; border-top: 1px solid #414b43; padding-top: 12px; }.plot-output.visible { display: block; }.plot-output svg { display: block; width: 100%; height: 120px; overflow: visible; }.plot-grid { stroke: #3e4940; stroke-width: 1; }.plot-line { fill: none; stroke: #e69a7d; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }.plot-area { fill: #e69a7d; opacity: .12; }.plot-point { fill: #b5d2b6; stroke: #252b28; stroke-width: 2; }.plot-axis-label { fill: #849a86; font: 9px 'IBM Plex Mono', monospace; }.notebook-footer { justify-content: space-between; color: #718073; padding: 11px 18px; font-size: 10px; }:global(.hidden) { display: none; }
	blockquote { border-left: 2px solid var(--coral); margin: 48px 0; padding: 2px 0 2px 24px; color: var(--green); font: 500 25px/1.45 'Source Serif 4', serif; }.tag-list { display: flex; gap: 8px; margin-top: 55px; }.tag-list a { color: var(--muted); background: #eeeee8; border-radius: 2px; padding: 8px 12px; text-decoration: none; font-size: 12px; }.end-note { display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--line); margin-top: 60px; padding-top: 24px; font: 13px/1.4 'DM Sans', sans-serif; }.end-note p { color: var(--muted); margin: 3px 0 0; font: 13px 'Source Serif 4', serif; }.end-note .follow-button { margin-left: auto; }.small { width: 43px; height: 43px; }.reading-rail { padding-top: 244px; color: var(--muted); }.rail-line { height: 150px; width: 1px; background: var(--line); margin-left: 6px; }.rail-line span { display: block; width: 1px; height: 38%; background: var(--coral); }.rail-label { display: block; font: 500 12px/1.2 'IBM Plex Mono', monospace; margin-top: 15px; }.rail-label small { color: var(--muted); font-size: 10px; }.rail-share { margin-top: 70px; font-size: 22px; color: var(--green); } footer { max-width: 1100px; border-top: 1px solid var(--line); margin: auto; padding: 25px 32px 40px; display: flex; justify-content: space-between; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; font: 10px 'IBM Plex Mono', monospace; }
	.prose :global(pre) { margin: 28px 0 0; overflow-x: auto; padding: 21px 24px 19px; background: #252b28; color: #e6ede5; border-radius: 5px 5px 0 0; font: 400 11.5px/1.72 'JetBrains Mono', 'IBM Plex Mono', monospace; font-variant-ligatures: contextual; font-feature-settings: 'calt' 1, 'liga' 1; letter-spacing: 0; tab-size: 2; }.prose :global(pre code) { font: inherit; font-variant-ligatures: inherit; }.prose :global(.code-cell) { margin: 42px 0 50px; padding: 0 0 15px; background: #252b28; border-radius: 6px; box-shadow: 0 16px 38px rgba(34, 44, 35, .13); overflow: hidden; }.prose :global(.code-cell pre) { margin: 0; border-radius: 0; }.prose :global(.code-toolbar) { display: flex; align-items: center; justify-content: space-between; min-height: 52px; padding: 10px 16px 10px 19px; border-top: 1px solid #414b43; background: #222824; }.prose :global(.code-language) { color: #a9c3ad; font: 500 10px 'JetBrains Mono', 'IBM Plex Mono', monospace; text-transform: uppercase; letter-spacing: .08em; }.prose :global(.code-cell .run-button) { display: inline-flex; align-items: center; gap: 8px; color: #d9eadb; border: 1px solid #62866b; border-radius: 4px; padding: 8px 12px; background: #304437; margin: 0; font: 500 10px 'JetBrains Mono', 'IBM Plex Mono', monospace; letter-spacing: .01em; transition: background .18s ease, border-color .18s ease, transform .18s ease; }.prose :global(.code-cell .run-button:hover) { background: #3a5541; border-color: #8fb098; transform: translateY(-1px); }.prose :global(.code-cell .run-button:focus-visible) { outline: 2px solid #f0b098; outline-offset: 3px; }.prose :global(.code-cell .run-button:disabled) { cursor: wait; opacity: .62; transform: none; }.prose :global(.code-cell .run-button span) { color: #f0b098; font-size: 9px; }.prose :global(.code-cell .run-button span) { color: #f0b098; font-size: 9px; }.prose :global(.code-cell .cell-output) { margin: 14px 19px 0; min-height: 18px; color: #9ab89f; font: 400 10px/1.5 'JetBrains Mono', 'IBM Plex Mono', monospace; letter-spacing: .01em; }.prose :global(.code-cell .plot-output) { margin-left: 19px; margin-right: 19px; }.prose :global(.plot-grid) { stroke: #3e4940; stroke-width: 1; }.prose :global(.plot-line) { fill: none; stroke: #e69a7d; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }.prose :global(.plot-area) { fill: #e69a7d; opacity: .12; }.prose :global(.plot-point) { fill: #b5d2b6; stroke: #252b28; stroke-width: 2; }.prose :global(.plot-axis-label) { fill: #849a86; font: 9px 'IBM Plex Mono', monospace; }
	@media (max-width: 760px) { .site-header { height: 62px; padding: 0 20px; }.header-nav { gap: 15px; }.header-nav a { display: none; }.brand-subtitle { display: none; }.article-layout { display: block; padding: 48px 20px 70px; }.reading-rail { display: none; } h1 { font-size: 53px; }.dek { font-size: 20px; }.hero-figure { height: 260px; margin-top: 32px; }.notebook { margin-left: -20px; margin-right: -20px; border-radius: 0; }.prose { font-size: 19px; }.prose h2 { font-size: 28px; }.prose :global(pre) { padding: 18px 16px 16px; font-size: 10.5px; line-height: 1.7; }.prose :global(.code-toolbar) { padding-left: 15px; padding-right: 15px; }.prose :global(.code-cell .cell-output) { margin-left: 15px; margin-right: 15px; }.end-note { align-items: flex-start; } footer { padding-left: 20px; padding-right: 20px; } }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script>
	const followButtons = document.querySelectorAll('.follow-button');
	followButtons.forEach((button) => button.addEventListener('click', () => { followButtons.forEach((item) => { item.classList.toggle('following'); item.textContent = item.classList.contains('following') ? 'Following' : 'Follow'; }); }));
	const clapButton = document.querySelector('#clap-button'); const clapCount = document.querySelector('#clap-count');
	clapButton?.addEventListener('click', () => { const clapped = clapButton.classList.toggle('clapped'); clapCount.textContent = String(Number(clapCount.textContent) + (clapped ? 1 : -1)); clapButton.querySelector('.action-icon').textContent = clapped ? '♥' : '♡'; });
	document.querySelector('#bookmark-button')?.addEventListener('click', (event) => { const button = event.currentTarget; button.querySelector('.action-icon').textContent = button.querySelector('.action-icon').textContent === '▱' ? '▰' : '▱'; });
	const chartData = [{ day: 0, value: 0.18 }, { day: 1, value: 0.42 }, { day: 2, value: 0.31 }, { day: 3, value: 0.78 }, { day: 4, value: 0.62 }, { day: 5, value: 0.91 }, { day: 6, value: 0.74 }, { day: 7, value: 0.99 }];
	function renderPlot(language, target) {
		target.innerHTML = ''; target.classList.add('visible');
		const width = 520; const height = 120; const pad = { top: 8, right: 8, bottom: 20, left: 8 }; const x = (value) => pad.left + (value / 7) * (width - pad.left - pad.right); const y = (value) => height - pad.bottom - value * (height - pad.top - pad.bottom);
		const points = chartData.map((item) => `${x(item.day)},${y(item.value)}`).join(' ');
		const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); svg.setAttribute('viewBox', `0 0 ${width} ${height}`); svg.setAttribute('role', 'img'); svg.setAttribute('aria-label', `${language} generated line chart`);
		[.25, .5, .75].forEach((value) => { const grid = document.createElementNS('http://www.w3.org/2000/svg', 'line'); grid.setAttribute('class', 'plot-grid'); grid.setAttribute('x1', String(pad.left)); grid.setAttribute('x2', String(width - pad.right)); grid.setAttribute('y1', String(y(value))); grid.setAttribute('y2', String(y(value))); svg.append(grid); });
		const area = document.createElementNS('http://www.w3.org/2000/svg', 'polygon'); area.setAttribute('class', 'plot-area'); area.setAttribute('points', `${pad.left},${height - pad.bottom} ${points} ${width - pad.right},${height - pad.bottom}`); svg.append(area);
		if (language === 'd3' && window.d3) { window.d3.select(svg).append('polyline').attr('class', 'plot-line').attr('points', points); } else { const line = document.createElementNS('http://www.w3.org/2000/svg', 'polyline'); line.setAttribute('class', 'plot-line'); line.setAttribute('points', points); svg.append(line); }
		chartData.forEach((item) => { const point = document.createElementNS('http://www.w3.org/2000/svg', 'circle'); point.setAttribute('class', 'plot-point'); point.setAttribute('cx', String(x(item.day))); point.setAttribute('cy', String(y(item.value))); point.setAttribute('r', '3.5'); svg.append(point); });
		const label = document.createElementNS('http://www.w3.org/2000/svg', 'text'); label.setAttribute('class', 'plot-axis-label'); label.setAttribute('x', String(pad.left)); label.setAttribute('y', String(height - 3)); label.textContent = `${language.toUpperCase()} / field intensity`; svg.append(label); target.append(svg);
	}
	document.querySelectorAll('.prose pre').forEach((pre) => {
		const code = pre.querySelector('code'); const language = pre.dataset.language ?? code?.className.match(/language-(\w+)/)?.[1] ?? 'javascript'; const languageLabel = language === 'javascript' ? 'JavaScript / D3' : language === 'common-lisp' ? 'Common Lisp / Quicklisp' : language; const cell = document.createElement('div'); cell.className = 'code-cell'; pre.parentElement?.insertBefore(cell, pre); cell.append(pre);
		const toolbar = document.createElement('div'); toolbar.className = 'code-toolbar'; toolbar.innerHTML = `<span class="code-language">${languageLabel}</span>`; const button = document.createElement('button'); button.className = 'run-button'; button.innerHTML = '<span>▶</span> Run cell'; toolbar.append(button); cell.append(toolbar);
		const output = document.createElement('div'); output.className = 'cell-output'; output.textContent = 'Output will appear here'; cell.append(output); const plot = document.createElement('div'); plot.className = 'plot-output'; plot.setAttribute('aria-label', `${language} generated plot`); cell.append(plot);
		button.addEventListener('click', async () => { button.disabled = true; button.innerHTML = '<span>◌</span> Preparing cell'; await new Promise((resolve) => setTimeout(resolve, 550)); output.textContent = language === 'python' ? 'peak: 0.999 · rendered 80 × 80 field' : language === 'julia' ? 'mean: 7.5 · rendered 8 samples' : language === 'common-lisp' ? 'Quicklisp loaded alexandria · mean: 7.50' : 'path: 1 · rendered 8 points'; renderPlot(language === 'javascript' ? 'd3' : language, plot); button.disabled = false; button.innerHTML = '<span>▶</span> Run again'; });
	});
</script>
