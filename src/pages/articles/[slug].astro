---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const articles = (await getCollection('articles')).filter(({ data }) => data.status === 'published');
	return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, author, authorInitials, pubDate, readTime, tags } = article.data;
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="https://github.com/leytzher.png?size=128" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<title>{title} | Leytzher Muro</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=JetBrains+Mono:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="site-header"><a class="wordmark" href="/" aria-label="Leytzher Muro home"><img src="https://github.com/leytzher.png?size=128" alt="" /><span>Leytzher Muro</span><small>computational reservoir engineering</small></a><nav><a href="/">All notes</a><button aria-label="Open profile">LM</button></nav></header>
		<main><a class="back-link" href="/">← Back to all notes</a><article><p class="eyebrow"><span></span>NOTES ON RESERVOIRS, COMPUTATION AND THE PHYSICS BETWEEN THEM</p><h1>{title}</h1><p class="dek">{description}</p><div class="byline"><span class="author-avatar">{authorInitials}</span><span><strong>{author}</strong><small>{formatDate(pubDate)} · {readTime}</small></span></div><div class="prose"><Content /></div><div class="tags">{tags.map((tag) => <span>{tag}</span>)}</div><div class="author-note"><span class="author-avatar">{authorInitials}</span><div><strong>Written by {author}</strong><p>Notes on reservoir engineering and computation.</p></div></div></article></main><footer><span>Leytzher Muro / 2026</span><span>computational reservoir engineering</span></footer>
	</body>
</html>

<style>
	:root { --ink:#202321; --muted:#6f746e; --paper:#fbfaf7; --line:#dedfd9; --green:#54705a; --coral:#da6d52; } * { box-sizing:border-box; } body { margin:0; color:var(--ink); background:var(--paper); font-family:'DM Sans',sans-serif; }.site-header { height:72px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; padding:0 max(32px, calc((100vw - 1180px) / 2)); }.wordmark { display:flex; align-items:center; gap:9px; color:var(--ink); text-decoration:none; font-size:14px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }.wordmark img { width:30px; height:30px; border-radius:50%; object-fit:cover; }.wordmark small { border-left:1px solid var(--line); padding-left:14px; margin-left:5px; color:var(--muted); font:400 10px 'IBM Plex Mono',monospace; text-transform:lowercase; }.site-header nav { display:flex; align-items:center; gap:22px; }.site-header nav a { color:var(--muted); font-size:13px; text-decoration:none; }.site-header nav button { width:30px; height:30px; border:0; border-radius:50%; background:var(--green); color:#fff; font-size:11px; }.back-link { display:inline-block; margin-bottom:50px; color:var(--green); font:500 11px 'IBM Plex Mono',monospace; text-decoration:none; }main { max-width:800px; margin:0 auto; padding:70px 32px 90px; }article h1 { max-width:760px; margin:22px 0 16px; font:600 clamp(48px,7vw,78px)/.98 'Source Serif 4',serif; letter-spacing:-.05em; }.eyebrow { color:var(--green); display:flex; align-items:center; gap:9px; margin:0; font:500 10px 'IBM Plex Mono',monospace; letter-spacing:.1em; }.eyebrow span { width:7px; height:7px; border-radius:50%; background:var(--coral); }.dek { max-width:640px; margin:0; color:var(--muted); font:22px/1.4 'Source Serif 4',serif; }.byline { display:flex; align-items:center; gap:10px; margin:32px 0 55px; font-size:12px; }.byline span:last-child { display:grid; gap:3px; }.byline small { color:var(--muted); }.author-avatar { width:38px; height:38px; border-radius:50%; display:grid; place-items:center; background:var(--green); color:white; font:11px 'IBM Plex Mono',monospace; }.prose { font:20px/1.72 'Source Serif 4',serif; }.prose p { margin:0 0 25px; }.prose h2 { margin:50px 0 16px; font:600 30px/1.2 'Source Serif 4',serif; }.prose :global(pre) { margin:30px 0 0; overflow-x:auto; padding:21px 24px 19px; background:#252b28; color:#e6ede5; border-radius:5px 5px 0 0; font:11.5px/1.72 'JetBrains Mono','IBM Plex Mono',monospace; font-variant-ligatures:contextual; }.prose :global(.code-cell) { margin:42px -18px 50px; background:#252b28; border-radius:6px; overflow:hidden; box-shadow:0 16px 38px rgba(34,44,35,.13); }.prose :global(.code-toolbar) { display:flex; justify-content:space-between; align-items:center; min-height:52px; padding:10px 16px 10px 19px; background:#222824; border-top:1px solid #414b43; }.prose :global(.code-language) { color:#a9c3ad; font:10px 'JetBrains Mono',monospace; text-transform:uppercase; letter-spacing:.08em; }.prose :global(.run-button) { margin:0; padding:8px 12px; border:1px solid #62866b; border-radius:4px; background:#304437; color:#d9eadb; font:10px 'JetBrains Mono',monospace; }.prose :global(.run-button span) { color:#f0b098; }.prose :global(.cell-output) { margin:14px 19px 0; min-height:18px; color:#9ab89f; font:10px 'JetBrains Mono',monospace; }.prose :global(.plot-output) { margin:14px 19px 16px; min-height:132px; border-top:1px solid #414b43; padding-top:12px; }.prose :global(.plot-output svg) { width:100%; height:120px; }.prose :global(.plot-grid) { stroke:#3e4940; }.prose :global(.plot-line) { fill:none; stroke:#e69a7d; stroke-width:2.5; }.prose :global(.plot-area) { fill:#e69a7d; opacity:.12; }.prose :global(.plot-point) { fill:#b5d2b6; }.prose :global(.plot-axis-label) { fill:#849a86; font:9px 'IBM Plex Mono',monospace; }.tags { display:flex; gap:7px; margin-top:55px; }.tags span { padding:7px 10px; background:#eeeee8; color:var(--muted); font-size:11px; }.author-note { display:flex; align-items:center; gap:12px; border-top:1px solid var(--line); margin-top:60px; padding-top:24px; font-size:13px; }.author-note p { margin:3px 0 0; color:var(--muted); font:13px 'Source Serif 4',serif; }footer { max-width:800px; margin:auto; border-top:1px solid var(--line); padding:25px 32px 40px; display:flex; justify-content:space-between; color:var(--muted); font:10px 'IBM Plex Mono',monospace; text-transform:uppercase; letter-spacing:.08em; }@media(max-width:700px){.site-header{padding:0 20px}.wordmark small{display:none}main{padding:42px 20px 70px}.prose{font-size:19px}.prose :global(.code-cell){margin-left:-20px;margin-right:-20px;border-radius:0}footer{margin:0 20px;padding-left:0;padding-right:0;flex-direction:column;gap:18px}}
+</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7"></script>
<script>
	const data = [{ day: 0, value: .18 }, { day: 1, value: .42 }, { day: 2, value: .31 }, { day: 3, value: .78 }, { day: 4, value: .62 }, { day: 5, value: .91 }, { day: 6, value: .74 }, { day: 7, value: .99 }];
	function plot(target, language) { const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); svg.setAttribute('viewBox', '0 0 520 120'); const x = (n) => 8 + n / 7 * 504; const y = (n) => 100 - n * 84; const points = data.map((item) => `${x(item.day)},${y(item.value)}`).join(' '); const area = document.createElementNS('http://www.w3.org/2000/svg', 'polygon'); area.setAttribute('class', 'plot-area'); area.setAttribute('points', `8,100 ${points} 512,100`); svg.append(area); const line = document.createElementNS('http://www.w3.org/2000/svg', 'polyline'); line.setAttribute('class', 'plot-line'); line.setAttribute('points', points); svg.append(line); data.forEach((item) => { const point = document.createElementNS('http://www.w3.org/2000/svg', 'circle'); point.setAttribute('class', 'plot-point'); point.setAttribute('cx', String(x(item.day))); point.setAttribute('cy', String(y(item.value))); point.setAttribute('r', '3.5'); svg.append(point); }); target.replaceChildren(svg); }
	document.querySelectorAll('.prose pre').forEach((pre) => { const language = pre.dataset.language ?? 'javascript'; const cell = document.createElement('div'); cell.className = 'code-cell'; pre.parentElement?.insertBefore(cell, pre); cell.append(pre); const toolbar = document.createElement('div'); toolbar.className = 'code-toolbar'; toolbar.innerHTML = `<span class="code-language">${language === 'javascript' ? 'JavaScript / D3' : language === 'common-lisp' ? 'Common Lisp / Quicklisp' : language}<\/span><button class="run-button"><span>▶</span> Run cell<\/button>`; cell.append(toolbar); const output = document.createElement('div'); output.className = 'cell-output'; output.textContent = 'Output will appear here'; cell.append(output); const plotOutput = document.createElement('div'); plotOutput.className = 'plot-output'; cell.append(plotOutput); toolbar.querySelector('button')?.addEventListener('click', () => { output.textContent = language === 'python' ? 'peak: 0.999 · rendered field' : language === 'julia' ? 'mean: 7.5 · rendered samples' : language === 'common-lisp' ? 'Quicklisp loaded · mean: 7.50' : 'path: 1 · rendered points'; plot(plotOutput, language); }); });
</script>
